---
import Icono from './Icono.astro';
import { caminos } from '../content';
// Estrellas fijas, generadas al compilar
let a = 23; const rnd = () => (a = (a * 16807) % 2147483647) / 2147483647;
const estrellas = Array.from({ length: 90 }, () => `<circle cx="${(rnd() * 1440).toFixed(1)}" cy="${(rnd() * 800).toFixed(1)}" r="${(0.6 + rnd() * 1.4).toFixed(2)}" fill="#F3DC8B" opacity="${(0.15 + rnd() * 0.5).toFixed(2)}"/>`).join('');
---
<section class="caminos" id="caminos">
  <svg class="caminos__estrellas" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMin slice" aria-hidden="true" set:html={estrellas} />
  <header class="caminos__enc" data-revelar>
    <div class="sobre" style="color: var(--oro)">Qué puedes contratar</div>
    <h2 class="oro">Tres caminos para empezar</h2>
    <p>Elige según dónde está tu empresa hoy.</p>
  </header>
  <div class="caminos__lista">
    {caminos.map((c) => (
      <article class="camino" data-revelar>
        <div class="camino__cab">
          <Icono nombre={c.icono} tamano={42} color="#F3DC8B" />
          <span class={`etiqueta ${c.estado === 'Disponible' ? 'etiqueta--si' : ''}`}>{c.estado}</span>
        </div>
        <h3 class="oro">{c.titulo}</h3>
        <p class="camino__texto">{c.texto}</p>
        <div class="camino__precio">{c.precio}</div>
        <a class={`btn btn--${c.estilo}`} href={c.href} data-interes={c.interes}>{c.boton}</a>
      </article>
    ))}
  </div>
</section>

<style>
  .caminos { background: var(--azul-prof); color: var(--marfil); padding: clamp(72px, 8vw, 128px) var(--pad); text-align: center; overflow: hidden; }
  .caminos__estrellas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .caminos__enc, .caminos__lista { position: relative; }
  .caminos__enc h2 { margin-top: 12px; }
  .caminos__enc p { margin-top: 12px; color: rgba(248, 245, 236, .75); }
  .caminos__lista { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 56px; text-align: left; }
  .camino { display: flex; flex-direction: column; align-items: flex-start; padding: 30px; border-radius: 18px; border: 1px solid rgba(212, 175, 55, .45); background: linear-gradient(180deg, rgba(27, 43, 79, .85), rgba(27, 43, 79, .45)); }
  .camino__cab { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  .etiqueta { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(243, 220, 139, .7); color: var(--oro-claro); white-space: nowrap; }
  .etiqueta--si { background: var(--oro); border-color: var(--oro); color: var(--azul-prof); }
  .camino h3 { font-size: clamp(21px, 1.8vw, 25px); margin-top: 16px; min-height: 2.35em; }
  .camino__texto { margin-top: 10px; font-size: 15.5px; opacity: .9; min-height: 4.8em; }
  .camino__precio { width: 100%; margin: 20px 0 22px; padding-top: 16px; border-top: 1px solid rgba(212, 175, 55, .3); color: var(--oro-claro); font-size: 15px; }
  .camino .btn { margin-top: auto; }
  @media (max-width: 960px) { .caminos__lista { grid-template-columns: 1fr; gap: 18px; margin-top: 36px; } .camino { padding: 24px 22px; } .camino h3, .camino__texto { min-height: 0; } .camino .btn { width: 100%; } }
</style>
