---
import { casos } from '../content';
import { waHref } from '../config';
---
<section class="casos" id="casos">
  <header class="casos__enc" data-revelar>
    <div class="sobre" style="color: var(--oro-viejo)">{casos.sobre}</div>
    <h2>{casos.titulo}</h2>
  </header>
  <div class="casos__lista">
    {casos.lista.map((c) => (
      <article class="caso" data-revelar>
        <span class="caso__etiqueta">{casos.etiqueta}</span>
        <h3>{c.sector}</h3>
        <div class="caso__fila caso__fila--antes"><span>Antes</span><p>{c.antes}</p></div>
        <div class="caso__flecha" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#8A6A1F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v15M6 13l6 6 6-6" /></svg></div>
        <div class="caso__fila caso__fila--despues"><span>Después</span><p>{c.despues}</p></div>
      </article>
    ))}
  </div>
  <div class="casos__pie" data-revelar>
    <p>{casos.nota}</p>
    <a class="btn btn--oro" href={waHref('Hola, quiero contarles mi caso para ver qué se puede automatizar.')} target={waHref('x').startsWith('http') ? '_blank' : undefined} rel="noopener">Cuéntanos tu caso</a>
  </div>
</section>

<style>
  .casos { background: var(--marfil); color: var(--tinta); padding: clamp(64px, 8vw, 112px) var(--pad) clamp(8px, 2vw, 24px); }
  .casos__enc { text-align: center; }
  .casos__enc h2 { color: var(--azul); margin: 12px auto 0; max-width: 820px; text-wrap: balance; }
  .casos__lista { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin-top: 56px; }
  .caso { display: flex; flex-direction: column; padding: 28px; border-radius: 18px; background: #fff; border: 1px solid rgba(138, 106, 31, .28); box-shadow: 0 22px 40px -28px rgba(15, 27, 51, .35); }
  .caso__etiqueta { align-self: flex-start; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(138, 106, 31, .5); color: var(--oro-viejo); }
  .caso h3 { font-size: 22px; color: var(--azul); margin: 16px 0 18px; }
  .caso__fila span { display: block; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; margin-bottom: 4px; }
  .caso__fila p { font-size: 15px; line-height: 1.6; }
  .caso__fila--antes span { color: rgba(17, 19, 24, .5); }
  .caso__fila--antes p { color: rgba(17, 19, 24, .62); }
  .caso__fila--despues span { color: var(--oro-viejo); }
  .caso__fila--despues p { color: var(--azul); }
  .caso__flecha { display: flex; justify-content: center; margin: 14px 0; }
  .casos__pie { margin-top: 44px; text-align: center; }
  .casos__pie p { margin-bottom: 18px; opacity: .72; font-size: 15px; }
  .casos__pie .btn--oro { color: var(--azul-prof); }
  @media (max-width: 960px) { .casos__lista { grid-template-columns: 1fr; gap: 18px; margin-top: 36px; } .caso { padding: 24px 22px; } }
</style>
