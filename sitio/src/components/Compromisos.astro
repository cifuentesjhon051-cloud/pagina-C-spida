---
import Icono from './Icono.astro';
import { compromisos, trabajos } from '../content';
---
<section class="comp" id="compromisos">
  <header class="comp__enc" data-revelar>
    <div class="sobre" style="color: var(--oro-viejo)">Por escrito, desde el primer día</div>
    <h2>Nuestros compromisos</h2>
  </header>
  <ul class="comp__lista">
    {compromisos.map((c) => (
      <li data-revelar>
        <span class="comp__icono"><Icono nombre={c.icono} tamano={28} color="#8A6A1F" /></span>
        <div><h3>{c.titulo}</h3><p>{c.texto}</p></div>
      </li>
    ))}
  </ul>

  <div class="trabajo">
    <header class="trabajo__enc" data-revelar>
      <div class="sobre" style="color: var(--oro-viejo)">Trabajo real</div>
      <h2>Sistemas que ya construimos</h2>
      <p>Dos puntos de venta construidos a la medida.</p>
    </header>
    <div class="trabajo__lista">
      {trabajos.map((t) => (
        <article class="pos" data-revelar>
          <div class="pos__cab"><Icono nombre={t.icono} tamano={36} color="#D4AF37" /><span class="pos__tag">{t.etiqueta}</span></div>
          <h3 class="oro">{t.titulo}</h3>
          <ul>{t.puntos.map((p) => <li>{p}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .comp { background: var(--marfil); color: var(--tinta); padding: clamp(64px, 8vw, 112px) var(--pad) clamp(72px, 8vw, 120px); }
  .comp__enc, .trabajo__enc { text-align: center; }
  .comp__enc h2 { color: var(--azul); margin-top: 12px; }
  .comp__lista { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 56px; margin-top: 64px; }
  .comp__lista li { display: flex; gap: 18px; align-items: flex-start; }
  .comp__icono { width: 60px; height: 60px; border-radius: 50%; border: 1.5px solid var(--oro-viejo); display: flex; align-items: center; justify-content: center; flex: none; }
  .comp__lista h3 { font-family: var(--sans); font-size: 18px; color: var(--azul); line-height: 1.3; }
  .comp__lista p { font-size: 15px; opacity: .74; margin-top: 3px; }
  .trabajo { margin-top: clamp(64px, 8vw, 110px); }
  .trabajo__enc h2 { font-size: clamp(26px, 2.5vw, 36px); color: var(--azul); margin-top: 10px; }
  .trabajo__enc p { margin-top: 10px; opacity: .75; }
  .trabajo__lista { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; margin-top: 44px; }
  .pos { padding: 30px; border-radius: 18px; background: var(--azul); color: var(--marfil); box-shadow: 0 26px 44px -26px rgba(15, 27, 51, .6); }
  .pos__cab { display: flex; align-items: center; justify-content: space-between; }
  .pos__tag { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(243, 220, 139, .7); color: var(--oro-claro); }
  .pos h3 { font-size: 24px; margin: 16px 0 14px; }
  .pos ul { display: grid; gap: 10px; }
  .pos li { position: relative; padding-left: 22px; font-size: 15px; line-height: 1.55; opacity: .94; }
  .pos li::before { content: ''; position: absolute; left: 2px; top: .62em; width: 8px; height: 8px; border-radius: 2px; background: var(--oro); transform: rotate(45deg); }
  @media (max-width: 960px) { .comp__lista { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 32px; } .trabajo__lista { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .comp__lista { grid-template-columns: 1fr; margin-top: 40px; gap: 24px; } .comp__icono { width: 52px; height: 52px; } .pos { padding: 24px 22px; } }
</style>
