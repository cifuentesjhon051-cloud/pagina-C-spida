---
import emblemaRaw from '../assets/emblema.svg?raw';
import logoRaw from '../assets/logo-completo.svg?raw';
import { agendaHref } from '../config';

const nombreD = logoRaw.match(/id="nombre"[^>]*d="([^"]+)"/)![1];
const esloganD = logoRaw.match(/id="eslogan"[^>]*d="([^"]+)"/)![1];
// El emblema va en línea para poder girar sus engranajes; se renombra el degradado para no chocar con otros.
const emblema = emblemaRaw
  .replace(/id="oro"/g, 'id="oro-h"').replace(/url\(#oro\)/g, 'url(#oro-h)')
  .replace(/<title>[^<]*<\/title>/, '').replace(/ role="img" aria-label="[^"]*"/, '')
  .replace('<svg ', '<svg class="hero__emblema" aria-hidden="true" focusable="false" ');
const grad = (id: string) => `<defs><linearGradient id="${id}" gradientUnits="userSpaceOnUse" x1="-200" y1="170" x2="200" y2="280"><stop offset="0" stop-color="#F3DC8B"/><stop offset=".45" stop-color="#D9B647"/><stop offset="1" stop-color="#B38D2A"/></linearGradient></defs>`;
---
<section class="hero" id="inicio" data-hero>
  <canvas class="hero__lienzo" aria-hidden="true"></canvas>
  <div class="hero__velo" aria-hidden="true"></div>
  <h1 class="solo-lectores">Cúspida · Elevación Empresarial: sistemas y automatización para tu empresa</h1>

  <a class="btn btn--linea hero__cta" href={agendaHref} target={agendaHref.startsWith('http') ? '_blank' : undefined} rel="noopener">Agenda tu diagnóstico</a>

  <div class="hero__bloque" aria-hidden="true">
    <Fragment set:html={emblema} />
    <div class="hero__zona hero__zona--nombre">
      <svg class="hero__nombre" viewBox="-198.5 163 397 77.5" focusable="false"><Fragment set:html={grad('oro-n')} /><path d={nombreD} fill="url(#oro-n)" /></svg>
    </div>
    <div class="hero__zona hero__zona--eslogan">
      <svg class="hero__eslogan" viewBox="-186.5 251.5 373 27.5" focusable="false"><Fragment set:html={grad('oro-e')} /><path d={esloganD} fill="url(#oro-e)" /></svg>
    </div>
  </div>

  <p class="hero__linea">Sistemas y automatización para que tu empresa llegue más alto.</p>
  <a class="hero__bajar" href="#servicios" aria-label="Ir a servicios">
    <svg viewBox="0 0 28 16" width="26" height="15" fill="none" stroke="#D4AF37" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l11 10L25 3" /></svg>
  </a>
  <svg class="hero__ola" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V36C180 6 360 6 540 30S900 58 1080 32S1320 6 1440 28V60Z" fill="#fff" /></svg>
</section>

<style>
  .hero {
    position: relative; height: 100svh; min-height: 620px; background: var(--azul-prof); overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; isolation: isolate;
  }
  .hero__lienzo { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  /* Despeja el centro para que el logo siempre se lea */
  .hero__velo {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 46% 52% at 50% 50%, rgba(10, 19, 38, .93) 0%, rgba(10, 19, 38, .55) 62%, rgba(10, 19, 38, 0) 100%);
  }
  .hero__cta { position: absolute; top: 28px; right: clamp(16px, 3.4vw, 48px); padding: 11px 22px; font-size: 14px; background: rgba(15, 27, 51, .55); backdrop-filter: blur(4px); }
  .hero__bloque { display: flex; flex-direction: column; align-items: center; height: var(--B); margin-top: -2svh; }
  .hero__zona { display: flex; align-items: center; justify-content: center; flex: none; width: 100%; }
  .hero__zona--nombre { height: calc(var(--B) * .236); }
  .hero__zona--eslogan { height: calc(var(--B) * .146); }
  .hero__nombre { height: calc(var(--B) * .236 * .62); max-width: 86vw; width: auto; margin-top: -2%; }
  .hero__eslogan { height: calc(var(--B) * .146 * .34); max-width: 80vw; width: auto; }
  .hero__linea {
    position: absolute; left: 0; right: 0; bottom: clamp(70px, 11svh, 108px); padding-inline: 40px;
    color: rgba(248, 245, 236, .82); font-size: clamp(14px, 1.3vw, 17px); letter-spacing: .06em; line-height: 1.45;
  }
  .hero__bajar { position: absolute; left: 50%; bottom: clamp(40px, 6.5svh, 64px); translate: -50% 0; padding: 8px; animation: bajar 2.4s ease-in-out infinite; }
  .hero__ola { position: absolute; left: 0; right: 0; bottom: -1px; width: 100%; height: clamp(34px, 4.4vw, 60px); }
  @keyframes bajar { 0%, 100% { transform: translateY(0); opacity: .75; } 50% { transform: translateY(7px); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .hero__bajar { animation: none; } }
  @media (max-width: 700px) {
    .hero__velo { background: radial-gradient(ellipse 80% 54% at 50% 48%, rgba(10, 19, 38, .93) 0%, rgba(10, 19, 38, .55) 62%, rgba(10, 19, 38, 0) 100%); }
  }
</style>

<script>
  import { iniciarHero } from '../scripts/hero';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const lienzo = hero?.querySelector('canvas');
  if (hero && lienzo) iniciarHero(hero, lienzo as HTMLCanvasElement);
</script>
