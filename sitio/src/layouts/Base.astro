---
import '../styles/global.css';
import { config } from '../config';
import Cookies from '../components/Cookies.astro';
interface Props { titulo?: string; descripcion?: string; noindex?: boolean; }
const {
  titulo = 'Cúspida · Sistemas y automatización para tu empresa en Medellín',
  descripcion = 'Consultoría en Medellín, Colombia: diagnosticamos tu empresa y construimos sistemas a la medida, integración de flujos de trabajo y herramientas con inteligencia artificial para automatizar tu negocio.',
  noindex = false,
} = Astro.props;
const url = config.sitio ? config.sitio + Astro.url.pathname : undefined;
// Solo se mide el sitio publicado (no localhost ni pruebas), con y sin "www"
const host = config.sitio ? new URL(config.sitio).hostname.replace(/^www\./, '') : '';
const dominios = host ? `${host},www.${host}` : undefined;
// Google Tag Manager con "Consent Mode": todo parte denegado y solo se concede la analítica si la persona acepta.
// La elección se guarda en el navegador ("cuspida-cookies"). No hay publicidad, así que ad_* siempre queda denegado.
const gtm = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500});
try{if(localStorage.getItem('cuspida-cookies')==='si')gtag('consent','update',{analytics_storage:'granted'})}catch(e){}
(function(w,d,s,l,i){w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f)})(window,document,'script','dataLayer','${config.gtmId}');`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: config.nombre,
  slogan: config.eslogan,
  ...(config.correo ? { email: config.correo } : {}),
  ...(config.whatsapp ? { telephone: '+' + config.whatsapp } : {}),
  description: descripcion,
  areaServed: { '@type': 'Country', name: 'Colombia' },
  address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressRegion: 'Antioquia', addressCountry: 'CO' },
  ...(config.sitio ? { url: config.sitio, logo: config.sitio + '/emblema.svg' } : {}),
};
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#0F1B33" />
    {noindex && <meta name="robots" content="noindex" />}
    {url && <link rel="canonical" href={url} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fuentes/Cinzel-600.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fuentes/Montserrat-500.ttf" as="font" type="font/ttf" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {url && <meta property="og:url" content={url} />}
    {config.sitio && <meta property="og:image" content={config.sitio + '/og.png'} />}
    {config.sitio && <meta property="og:image:width" content="1200" />}
    {config.sitio && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={config.sitio ? 'summary_large_image' : 'summary'} />
    {config.sitio && <meta name="twitter:image" content={config.sitio + '/og.png'} />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {config.gtmId && <script is:inline set:html={gtm} />}
    {config.umamiId && (
      <script is:inline defer src={config.umamiSrc} data-website-id={config.umamiId} data-do-not-track="true" data-domains={dominios} />
    )}
  </head>
  <body>
    {config.gtmId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${config.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <slot />
    <Cookies />
  </body>
</html>
